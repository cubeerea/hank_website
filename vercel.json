{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/paper.html", "destination": "/pid-steering", "permanent": true },
    { "source": "/paper", "destination": "/pid-steering", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ]
}
